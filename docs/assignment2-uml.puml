@startuml
title Drone Delivery Factory System

top to bottom direction
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam packageStyle rectangle
hide empty fields

package "Client and business layer" {
    class Main <<Client>>
    class DeliveryAppFrame <<Swing UI>> {
        -familyBox
        -modeBox
        -weightField
        -distanceField
        +createDelivery()
    }
    class DeliveryOrder <<record>> {
        +id: String
        +weightKg: double
        +distanceKm: double
        +mode: DeliveryMode
    }
    enum DeliveryMode {
        PRIORITY
        STANDARD
        ECO
    }
    class "DeliveryPlatform<F>" as Platform {
        +from(factory): DeliveryPlatform<F>
        +processDelivery(order): String
        +routePreview(order): String
        +quote(order): String
        +fulfil(order): String
        +calculatePrice(order): double
        +baseRatePerKm(): double
        +modePriceMultiplier(mode): double
    }
}

package "Abstract Factory" {
    class FactorySelector {
        +select(familyName): SystemFactory<?>
    }
    interface "SystemFactory<F>" as SystemFactory {
        +createDrone(): Drone<F>
        +createRoutePlanner(): RoutePlanner<F>
        +createPaymentGateway(): PaymentGateway<F>
    }
    interface "Drone<F>" as Drone {
        +identifier(): String
        +maxWeightKg(): double
        +fly(distanceKm): String
    }
    interface "RoutePlanner<F>" as Planner {
        +planRoute(distanceKm): String
    }
    interface "PaymentGateway<F>" as Payment {
        +ratePerKm(): double
        +calculateBasePrice(distanceKm): double
        +gatewayName(): String
        +charge(amount): String
    }
    interface NetworkFamily
}

package "Factory Method" {
    abstract class "DispatchCreator<F>" as Creator {
        #createStrategy(): DispatchStrategy<F>
        +scheduleDelivery(...): String
        +priceMultiplier(): double
    }
    interface "DispatchStrategy<F>" as Strategy {
        +dispatch(...): String
        +priceMultiplier(): double
    }
    class PriorityCreator
    class StandardCreator
    class EcoCreator
    class PriorityDispatch
    class StandardDispatch
    class EcoDispatch

    Creator <|-- PriorityCreator
    Creator <|-- StandardCreator
    Creator <|-- EcoCreator
    Creator ..> Strategy : Factory Method
    Strategy <|.. PriorityDispatch
    Strategy <|.. StandardDispatch
    Strategy <|.. EcoDispatch
}

package "Metro family" {
    class Metro
    class MetroFactory
    class MetroDrone
    class MetroRoutePlanner
    class MetroPayment

    MetroFactory ..> MetroDrone : creates
    MetroFactory ..> MetroRoutePlanner : creates
    MetroFactory ..> MetroPayment : creates
}

package "Campus family" {
    class Campus
    class CampusFactory
    class CampusDrone
    class CampusRoutePlanner
    class CampusPayment

    CampusFactory ..> CampusDrone : creates
    CampusFactory ..> CampusRoutePlanner : creates
    CampusFactory ..> CampusPayment : creates
}

package "Coastal family" {
    class Coastal
    class CoastalFactory
    class CoastalDrone
    class CoastalRoutePlanner
    class CoastalPayment

    CoastalFactory ..> CoastalDrone : creates
    CoastalFactory ..> CoastalRoutePlanner : creates
    CoastalFactory ..> CoastalPayment : creates
}

package "Mountain family" {
    class Mountain
    class MountainFactory
    class MountainDrone
    class MountainRoutePlanner
    class MountainPayment

    MountainFactory ..> MountainDrone : creates
    MountainFactory ..> MountainRoutePlanner : creates
    MountainFactory ..> MountainPayment : creates
}

Main --> DeliveryAppFrame : launches
DeliveryAppFrame --> FactorySelector : selected family
DeliveryAppFrame --> DeliveryOrder : creates
DeliveryAppFrame --> Platform : processDelivery(order)

FactorySelector --> SystemFactory : returns
Platform ..> SystemFactory : from(factory)
Platform o-- Drone
Platform o-- Planner
Platform o-- Payment
Platform ..> Creator : mode selection
Platform ..> DeliveryOrder
DeliveryOrder --> DeliveryMode

SystemFactory <|.. MetroFactory
SystemFactory <|.. CampusFactory
SystemFactory <|.. CoastalFactory
SystemFactory <|.. MountainFactory

NetworkFamily <|.. Metro
NetworkFamily <|.. Campus
NetworkFamily <|.. Coastal
NetworkFamily <|.. Mountain

Drone <|.. MetroDrone
Drone <|.. CampusDrone
Drone <|.. CoastalDrone
Drone <|.. MountainDrone

Planner <|.. MetroRoutePlanner
Planner <|.. CampusRoutePlanner
Planner <|.. CoastalRoutePlanner
Planner <|.. MountainRoutePlanner

Payment <|.. MetroPayment
Payment <|.. CampusPayment
Payment <|.. CoastalPayment
Payment <|.. MountainPayment

note right of Platform
processDelivery() executes three operations:
1. routePreview(): route + drone capacity
2. quote(): route + tariff + mode multiplier
3. fulfil(): dispatch + flight + payment
end note

note right of SystemFactory
The generic family F keeps Drone,
RoutePlanner and PaymentGateway compatible.
Mixed product families do not type-check.
end note

note right of Strategy
PRIORITY: x1.40
STANDARD: x1.00
ECO: x0.85
end note

@enduml
